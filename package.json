    "@iconify-json/fa7-brands": "^1.2.0",
    "@iconify-json/fa7-regular": "^1.2.1",
    "@iconify-json/fa7-solid": "^1.2.2",
    "@iconify/tools": "^4.1.4",
    "@iconify/types": "^2.0.0",
    "@react-router/dev": "^7.9.2",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.2.2",
    "@unocss/preset-icons": "^66.5.4",
    "@unocss/preset-mini": "^66.5.4",
    "@unocss/preset-wind4": "^66.5.4",
    "@unocss/vite": "^66.5.4",
    "typescript": "^5.9.2",
    "unocss": "^66.5.4",
    "vite": "^7.1.10",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "name": "test-hono-react-router-vite",
  "private": true,
  "scripts": {
    "build": "react-router build --config ./vite.react-router.config.ts --mode production && vite build --config ./vite.hono.config.ts --mode production",
    "check": "react-router typegen && tsc",
    "convert-fa-pro": "node scripts/convert-fa-pro.ts",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "pnpm run build && pnpm start",
    "start": "node ./build/server.js"
  },
  "type": "module"
}
