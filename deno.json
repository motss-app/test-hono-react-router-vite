{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDirs": [
      ".",
      ".react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "types": [
      "vite/client"
    ],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "react-dom/server": "npm:react-dom@19.2.0/server.edge"
  },
  "lock": true,
  "nodeModulesDir": "auto",
  "permissions": {
    "default": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    },
    "env": {
      "env": true
    },
    "format": {
      "env": true,
      "run": true
    },
    "lint": {
      "env": true,
      "run": true
    },
    "start": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "tasks": {
    "bench": "ulimit -n 9998999 && deno run build && ./http-bench --target 'deno:PORT=3000 deno run --v8-flags=\"--max-old-space-size=8192\" start' --duration 30 --connections 7999 --url http://localhost:3000/api/test",
    "build": "deno run -P npm:@react-router/dev build --config ./vite.react-router.config.ts --mode production && deno run -P npm:vite build --config ./vite.hono.config.ts --mode production",
    "build:worker": "deno run -P npm:@react-router/dev build --config ./vite.react-router.config.ts --mode production && deno run -P npm:vite build --config ./vite.worker.config.ts --mode production",
    "check": " deno run -P npm:@react-router/dev typegen && deno check",
    "convert-fa-pro": "deno run -P=env scripts/convert-fa-pro.ts",
    "dev": "deno run -P npm:vite",
    "format": "deno run -P=format npm:@biomejs/biome format --write .",
    "format:check": "deno run -P=format npm:@biomejs/biome format .",
    "lint": "deno lint && deno run -P=lint npm:@biomejs/biome check .",
    "lint:fix": "deno run -P=lint npm:@biomejs/biome check --write .",
    "preview": "deno task build && deno task start",
    "preview:worker": "deno task build:worker && deno run -A npm:wrangler dev",
    "start": "deno run -P=start ./build/server.js"
  },
  "unstable": [
    "bare-node-builtins",
    "broadcast-channel",
    "byonm",
    "detect-cjs",
    "fmt-component",
    "fs",
    "http",
    "net",
    "node-globals",
    "raw-imports",
    "sloppy-imports",
    "temporal",
    "unsafe-proto",
    "webgpu",
    "worker-options"
  ]
}
