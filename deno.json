{
  "allowScripts": {
    "allow": [
      "npm:@sentry/cli",
      "npm:core-js@3.50.0",
      "npm:sharp",
      "npm:sharp@0.33.5",
      "npm:workerd",
      "npm:workerd@1.20251202.0"
    ],
    "deny": [
      "npm:contextify@0.1.15",
      "npm:esbuild@0.28.1",
      "npm:fsevents@2.3.3",
      "npm:@inlang/message-lint-rule-empty-pattern@1.4.8",
      "npm:@inlang/message-lint-rule-missing-translation@1.4.8"
    ]
  },
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDirs": [
      ".",
      ".react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "types": [
      "./packages/frontend/app/types/vite-env.d.ts",
      "vite/client"
    ],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "exclude": [
    ".worktrees",
    ".wrangler",
    "k6-load-test.mjs",
    "packages/healthz-rust",
    "packages/fractal-wasm",
    "packages/fractal-rust",
    "packages/color-wasm",
    "packages/color-rust",
    "packages/image-optimize-rust"
  ],
  "fmt": {
    "exclude": [
      "packages/frontend/app/labs-wasm"
    ]
  },
  "imports": {
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "lint": {
    "exclude": [
      "packages/frontend/app/labs-wasm"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "lock": true,
  "nodeModulesDir": "auto",
  "permissions": {
    "default": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    },
    "env": {
      "env": true
    },
    "format": {
      "env": true,
      "run": true
    },
    "lint": {
      "env": true,
      "run": true
    },
    "start": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "tasks": {
    "bench": "ulimit -n 9998999 && deno task build && ./http-bench --target 'deno:PORT=8787 deno task --cwd=packages/gateway preview' --duration 30 --connections 7999 --url http://localhost:8787/api/test",
    "bench:all": "ulimit -n 9998999 && deno run -A scripts/bench-all.ts",
    "build": "deno task build:frontend && deno task build:gateway",
    "build:bff": "deno task --cwd=packages/bff typecheck",
    "build:fractal-wasm": "bash packages/fractal-wasm/build.sh",
    "build:frontend": "deno task --cwd=packages/frontend build",
    "build:gateway": "deno task --cwd=packages/gateway build",
    "build:gateway:canary": "deno task --cwd=packages/gateway build:canary",
    "build:worker": "deno task build:gateway",
    "build:worker:canary": "deno task build:gateway:canary",
    "check": "deno task typegen && deno task --cwd=packages/bff typecheck && deno task --cwd=packages/frontend typecheck && deno task --cwd=packages/gateway typecheck && deno check --unstable-tsgo",
    "convert-fa-pro": "deno run -P=env scripts/convert-fa-pro.ts",
    "dev": "deno run -A scripts/dev-spotlight.ts",
    "dev:app": "deno task --cwd=packages/frontend dev",
    "dev:gateway": "deno task --cwd=packages/gateway dev",
    "format": "deno run -P=format npm:@biomejs/biome format --write .",
    "format:check": "deno run -P=format npm:@biomejs/biome format .",
    "kill-ports": "deno run -A scripts/kill-ports.ts",
    "kill-ports:all": "deno run -A scripts/kill-ports.ts 5173 8787 3000 --verbose",
    "lint": "deno lint && deno run -P=lint npm:@biomejs/biome check .",
    "lint:fix": "deno run -P=lint npm:@biomejs/biome check --write .",
    "preview": "deno task build && deno task --cwd=packages/gateway preview",
    "preview:worker": "deno task preview",
    "route-bundle-size": "deno run -A scripts/route-bundle-size.ts",
    "spotlight": "pnpm dlx @spotlightjs/spotlight",
    "start": "deno task preview",
    "test": "deno task --cwd=packages/bff test && deno task --cwd=packages/frontend test && deno task --cwd=packages/gateway test",
    "test:visual": "deno run -A scripts/vrt.ts",
    "typegen": "REACT_ROUTER_ROOT=$PWD deno run -A npm:@react-router/dev typegen --config packages/frontend/vite.react-router.config.ts"
  },
  "unstable": [
    "bare-node-builtins",
    "broadcast-channel",
    "bundle",
    "byonm",
    "detect-cjs",
    "ffi",
    "fmt-component",
    "fmt-sql",
    "fs",
    "http",
    "kv",
    "net",
    "node-globals",
    "raw-imports",
    "sloppy-imports",
    "temporal",
    "unsafe-proto",
    "webgpu",
    "worker-options"
  ],
  "workspace": [
    "./packages/bff",
    "./packages/frontend",
    "./packages/gateway"
  ]
}
