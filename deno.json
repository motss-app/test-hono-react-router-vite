{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDirs": [
      ".",
      ".react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictBuiltinIteratorReturn": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "types": [
      "vite/client"
    ],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true
  },
  "imports": {
    "@base-ui-components/react": "npm:@base-ui-components/react@1.0.0-beta.4",
    "@biomejs/biome": "npm:@biomejs/biome@2.3.5",
    "@hono/node-server": "npm:@hono/node-server@1.19.6",
    "@hono/vite-dev-server": "npm:@hono/vite-dev-server@0.23.0",
    "@iconify-json/fa7-brands": "npm:@iconify-json/fa7-brands@1.2.0",
    "@iconify-json/fa7-regular": "npm:@iconify-json/fa7-regular@1.2.1",
    "@iconify-json/fa7-solid": "npm:@iconify-json/fa7-solid@1.2.2",
    "@iconify/tailwind4": "npm:@iconify/tailwind4@1.1.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.1.17",
    "@types/react": "npm:@types/react@19.2.5",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "hono": "npm:hono@4.10.6",
    "hono/context-storage": "npm:hono@4.10.6/context-storage",
    "hono/deno": "npm:hono@4.10.6/deno",
    "hono/timing": "npm:hono@4.10.6/timing",
    "react": "npm:react@19.2.0",
    "react-dom": "npm:react-dom@19.2.0",
    "react-dom/server": "npm:react-dom@19.2.0/server.node",
    "react-router": "npm:react-router@7.9.6",
    "tailwindcss": "npm:tailwindcss@4.1.17",
    "typescript": "npm:typescript@5.9.3",
    "vite": "npm:vite@7.2.2",
    "vite-tsconfig-paths": "npm:vite-tsconfig-paths@5.1.4"
  },
  "lock": true,
  "nodeModulesDir": "auto",
  "permissions": {
    "default": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    },
    "env": {
      "env": true
    },
    "format": {
      "env": true,
      "run": true
    },
    "lint": {
      "env": true,
      "run": true
    },
    "start": {
      "env": true,
      "net": true,
      "read": true
    }
  },
  "tasks": {
    "bench": "ulimit -n 9998999 && deno run build && ./http-bench --target 'deno:PORT=3000 deno run --v8-flags=\"--max-old-space-size=8192\" start' --duration 30 --connections 7999 --url http://localhost:3000/api/test",
    "build": "deno run -P npm:@react-router/dev build --config ./vite.react-router.config.ts --mode production && deno run -P npm:vite build --config ./vite.hono.config.ts --mode production",
    "check": " deno run -P npm:@react-router/dev typegen && deno check",
    "convert-fa-pro": "deno run -P=env scripts/convert-fa-pro.ts",
    "dev": "deno run -P npm:vite",
    "format": "deno run -P=format npm:@biomejs/biome format --write .",
    "format:check": "deno run -P=format npm:@biomejs/biome format .",
    "lint": "deno lint && deno run -P=lint npm:@biomejs/biome check .",
    "lint:fix": "deno run -P=lint npm:@biomejs/biome check --write .",
    "preview": "deno task build && deno task start",
    "start": "deno run -P=start ./build/server.js"
  },
  "unstable": [
    "bare-node-builtins",
    "broadcast-channel",
    "byonm",
    "detect-cjs",
    "fmt-component",
    "fs",
    "http",
    "net",
    "node-globals",
    "raw-imports",
    "sloppy-imports",
    "temporal",
    "unsafe-proto",
    "webgpu",
    "worker-options"
  ]
}
