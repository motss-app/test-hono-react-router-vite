{
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.unstable",
      "esnext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "exports": {
    ".": "./src/worker.ts",
    "./worker": "./src/worker.ts"
  },
  "name": "@motss-app/gateway",
  "permissions": {
    "default": {
      "env": true,
      "ffi": true,
      "net": true,
      "read": true,
      "run": true,
      "sys": true,
      "write": true
    }
  },
  "tasks": {
    "build": "deno run -A npm:vite build",
    "build:canary": "deno run -A npm:vite build --mode canary",
    "dev": "CLOUDFLARE_ENV=dev deno run -A ../../scripts/run-with-cleared-ports.ts 8787 -- deno run -A npm:vite",
    "preview": "deno run -A npm:vite preview",
    "test": "echo \"No tests yet\"",
    "typecheck": "deno check --unstable-tsgo src/worker.ts vite.config.ts"
  },
  "version": "0.1.0"
}
