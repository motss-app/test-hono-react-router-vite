{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [
      "../..",
      "../../.react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "vite/client"
    ],
    "verbatimModuleSyntax": true
  },
  "exports": {
    ".": "./worker.ts",
    "./monitoring/sentry": "./app/monitoring/sentry.ts",
    "./utils/csp": "./app/utils/csp.ts",
    "./utils/error-scenarios": "./app/utils/error-scenarios.ts",
    "./worker": "./worker.ts"
  },
  "imports": {
    "posthog-js": "npm:posthog-js@1.417.1",
    "posthog-node": "npm:posthog-node@5.49.1"
  },
  "name": "@motss-app/frontend",
  "tasks": {
    "build": "deno task build:react-router && deno task build:worker",
    "build:canary": "deno task build:react-router:canary && deno task build:worker:canary",
    "build:react-router": "deno run -A npm:@react-router/dev build --config ./vite.react-router.config.ts",
    "build:react-router:canary": "deno run -A npm:@react-router/dev build --config ./vite.react-router.config.ts --mode canary",
    "build:worker": "deno run -A npm:vite build --config ./vite.worker.config.ts",
    "build:worker:canary": "deno run -A npm:vite build --config ./vite.worker.config.ts --mode canary",
    "dev": "CLOUDFLARE_ENV=dev deno run -A ../../scripts/run-with-cleared-ports.ts 5173 -- deno run -A npm:vite",
    "preview": "deno run -A npm:vite preview",
    "test": "deno x vp test run",
    "test:browser": "deno x vp test run --project browser",
    "test:browser:watch": "deno x vp test --project browser",
    "test:unit": "deno x vp test run --project unit",
    "test:unit:watch": "deno x vp test --project unit",
    "typecheck": "deno check --unstable-tsgo worker.ts react-router.config.ts vite.config.ts vite.react-router.config.ts vite.worker.config.ts"
  },
  "version": "0.1.0"
}
