{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.window",
      "deno.ns",
      "deno.worker",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [
      "../..",
      "../../.react-router/types"
    ],
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "vite/client"
    ],
    "verbatimModuleSyntax": true
  },
  "exports": {
    ".": "./workers/app.ts",
    "./worker": "./workers/app.ts"
  },
  "name": "@motss-app/frontend",
  "tasks": {
    "build": "deno task build:react-router && deno task build:worker",
    "build:react-router": "deno run -A npm:@react-router/dev build --config ./vite.react-router.config.ts",
    "build:worker": "deno run -A npm:vite build --config ./vite.worker.config.ts",
    "dev": "deno run -A ../../scripts/run-with-cleared-ports.ts 5173 -- deno run -A npm:vite",
    "preview": "deno run -A npm:vite preview",
    "typecheck": "deno check --unstable-tsgo workers/app.ts react-router.config.ts vite.config.ts vite.react-router.config.ts vite.worker.config.ts"
  },
  "version": "0.1.0"
}
