{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "baseUrl": ".",
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@motss-app/bff": [
        "./packages/bff/src/api.ts"
      ],
      "@motss-app/bff/*": [
        "./packages/bff/src/*"
      ],
      "@motss-app/frontend/monitoring/sentry": [
        "./packages/frontend/app/monitoring/sentry.ts"
      ],
      "@motss-app/frontend/utils/*": [
        "./packages/frontend/app/utils/*"
      ]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "include": [
    "./*.ts",
    "packages/frontend/app/**/*",
    "vite-plugins/**/*.ts"
  ]
}
