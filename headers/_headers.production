# Static assets
/*.html
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=180, must-revalidate, no-transform

/*.ico
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.txt
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.json
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.png
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.jpg
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.svg
  Cache-Control: public, max-age=1800, s-maxage=10800, stale-while-revalidate=300, must-revalidate

/*.css
  Cache-Control: public, max-age=900, s-maxage=86400, stale-while-revalidate=300, must-revalidate

/*.js
  Cache-Control: public, max-age=900, s-maxage=86400, stale-while-revalidate=300, must-revalidate

# Static assets with content hashing
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000, s-maxage=31536000, stale-while-revalidate=86400, immutable

# Static SSG route headers are generated during the build so each page
# gets a route-specific CSP based on its final inline scripts and styles.
