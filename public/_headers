/*.js
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=60

# Static assets with content hashing
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, s-maxage=31536000, stale-while-revalidate=3600, immutable

